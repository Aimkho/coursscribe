# Variables d'environnement de CoursScribe (à saisir dans Vercel > Settings > Environment Variables)

# Clé Gemini (Google AI Studio > Get API key). Le projet Google doit avoir la facturation activée (offre payante).
GEMINI_API_KEY=

# Base Supabase : chaîne « Transaction pooler » (port 6543), rôle coursscribe_app
# Format : postgresql://coursscribe_app.rxlujvkutaaprcdnbqdj:MOT_DE_PASSE@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Projet Supabase (stockage des fichiers audio via la fonction audio-gateway)
SUPABASE_URL=https://rxlujvkutaaprcdnbqdj.supabase.co

# Facultatif : modèles Gemini (valeur par défaut : gemini-3.5-flash-lite pour les deux)
# GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
# GEMINI_STT_MODEL=gemini-3.5-flash-lite
